{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "fix", "release": "patch" },
          { "type": "feat", "release": "minor" },
          { "type": "bump", "release": "patch" },
          { "type": "perf", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance" },
            { "type": "bump", "section": "Miscellaneous" }
          ]
        }
      }
    ],
    "@MorpheApp/changelog",
    "gradle-semantic-release-plugin",
    [
      "@semantic-release/exec",
      {
        "generateNotesCmd": "./gradlew :patches:generatePatchesList && python3 .github/scripts/generate_patches_readme.py"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "patches-list.json",
          "patches-bundle.json",
          "CHANGELOG.md",
          "README.md"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "patches/build/libs/patches-*.mpp" }
        ]
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "branches": ["main"],
        "backmergeTo": ["dev"]
      }
    ]
  ]
}
